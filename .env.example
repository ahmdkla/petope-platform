# EXSAVERSE — environment
#
# Copy to `.env` for local development. On Vercel these are set in
# Project → Settings → Environment Variables instead; there is no .env file in
# a deployment. See docs/DEPLOY.md.
#
# `.env` is gitignored. Never commit real values — BETTER_AUTH_SECRET signs
# sessions and DATABASE_URL contains the database password.


# ---------------------------------------------------------------------------
# DATABASE_URL — required, secret
# ---------------------------------------------------------------------------
# The POOLED Neon connection string, with `sslmode=verify-full`.
#
#   Pooled            The host must contain `-pooler`. Serverless functions open
#                     a connection per invocation and would exhaust a direct
#                     Postgres endpoint under any real traffic. Copy the string
#                     Neon labels "Pooled connection", not the direct one.
#   sslmode=verify-full
#                     Verifies the server certificate AND that the hostname
#                     matches it. `require` alone encrypts but authenticates
#                     nothing, so it does not stop an interception. Neon serves
#                     a publicly-trusted certificate, so no CA bundle is needed.
#   channel_binding=require
#                     Neon includes this; keep it. It binds the auth exchange to
#                     the TLS channel.
#
# Used at runtime by lib/db.ts (through @prisma/adapter-pg) and by the Prisma
# CLI through prisma.config.ts.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"


# ---------------------------------------------------------------------------
# DIRECT_URL — optional, secret
# ---------------------------------------------------------------------------
# The UNPOOLED Neon string (same host without `-pooler`), used ONLY by the
# Prisma CLI for migrations. Prisma Migrate takes a session-scoped advisory
# lock, and Neon's pooler is PgBouncer in transaction mode, which can drop it
# and fail a deploy mid-migration.
#
# Migrations do run through the pooled endpoint here, so this is not required.
# Set it if a deploy ever fails with an advisory-lock or P3005-style error.
# The application at runtime always uses the pooled DATABASE_URL regardless.
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=verify-full"


# ---------------------------------------------------------------------------
# BETTER_AUTH_SECRET — required, secret
# ---------------------------------------------------------------------------
# Signs session cookies. Generate a fresh one per environment:
#
#   openssl rand -hex 32
#
# Rotating it invalidates every existing session, which is the intended
# emergency response to a suspected leak. Never reuse the development value in
# production.
BETTER_AUTH_SECRET=""


# ---------------------------------------------------------------------------
# BETTER_AUTH_URL — required, not secret
# ---------------------------------------------------------------------------
# The canonical origin the app is served from, with no trailing slash. Better
# Auth builds callback URLs from it and checks the request Origin against it, so
# a wrong value produces MISSING_OR_NULL_ORIGIN / failed sign-ins rather than a
# silent fallback.
#
# Local:      http://localhost:3000
# Production: https://your-domain.com   (the custom domain, or the stable
#                                        *.vercel.app production URL — NOT a
#                                        per-deployment preview URL)
BETTER_AUTH_URL="http://localhost:3000"


# ---------------------------------------------------------------------------
# DEMO_MODE — required, not secret
# ---------------------------------------------------------------------------
# "true" shows the persistent "no real payments are processed" banner and
# relaxes payment-proof format validation so test references can be entered.
#
# It NEVER auto-confirms a payment proof. Manual middleman verification is the
# thing this project exists to demonstrate; nothing in demo mode bypasses it.
#
# This build is a university project with no real funds, so it ships "true".
# Set "false" only alongside real email delivery and real operational review.
DEMO_MODE="true"
