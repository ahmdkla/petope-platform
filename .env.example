# Placeholder only — nothing in this project connects to a database yet.
# Prisma requires DATABASE_URL to resolve for `prisma validate` to run.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"

# Demo / academic build: shows the "no real payments are processed" banner and
# relaxes proof-format validation. NEVER auto-confirms a payment proof.
DEMO_MODE="true"

# Better Auth. BETTER_AUTH_SECRET signs sessions - keep it out of git.
# Generate a new one with: openssl rand -hex 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
