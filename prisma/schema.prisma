// EXSAVERSE — WL marketplace + middleman escrow.
//
// Scope: build-order steps 1-4 (auth/profiles/MM roster, listings, deal rooms
// + lifecycle, payment proofs + manual verification + ledger).
//
// TWO THINGS THIS SCHEMA DELIBERATELY DOES NOT CONTAIN:
//   1. Any wallet, RPC, SDK or on-chain verification surface. Payment
//      verification is manual — a middleman opens a Solscan link, checks it
//      personally, and confirms. See "Payment Verification Is Manual" in
//      CLAUDE.md. Wallet addresses and tx references are opaque human-read
//      strings; the platform never parses or resolves them.
//   2. Any field capable of holding a private key or seed phrase. Key handover
//      happens off-platform; only the fact that it was declared is recorded.
//
// Money is always a BigInt in the asset's smallest unit, stored beside its
// PaymentAsset. Never a Float, never a bare number. BigInt does not survive
// JSON.stringify — serialize with superjson.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 removed `url` from the datasource block — the connection string
// now lives in prisma.config.ts.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  MIDDLEMAN
  MAIN_MIDDLEMAN // Boss MM — final say on escalated disputes
  ADMIN
}

/// Users are never hard deleted: onDelete: Restrict on every deal-related
/// relation makes that impossible by design, so removal is a status change.
enum UserStatus {
  ACTIVE
  SUSPENDED
  BLACKLISTED
}

enum ListingSide {
  BUY
  SELL
}

/// The listing form's coarse, browsable filter. NOT the escrow flow.
/// Kept strictly separate from DealMethod — see the taxonomy note in CLAUDE.md.
enum ListingType {
  ANY // explicitly "open to negotiation" — method decided in the ticket
  MINT
  TOKEN_TRANSFER
  WALLET_SUBMIT
  WALLET_SURRENDER
}

enum ListingStatus {
  ACTIVE
  /// DEPRECATED — never written. Listings no longer lock on deal creation:
  /// spots reserve only at funding, so several buyers compete for one listing.
  /// Kept so historical rows remain readable.
  IN_DEAL
  DELISTED
  /// DEPRECATED — superseded by SOLD_OUT. Kept for historical rows.
  FULFILLED
  /// quantityRemaining has reached zero. Stays visible in the feed but accepts
  /// no new deals. Returns to ACTIVE if a funded deal is refunded or cancelled.
  SOLD_OUT
  EXPIRED
}

/// "3 for $15 for all" is not "3 for $15 for each". Always render the
/// resolved total in the UI so this cannot be misread.
enum PriceType {
  FOR_EACH
  FOR_ALL
}

/// Settlement asset allowlist — Solana network. Reject anything outside it.
/// Separate from the *project's* chain, which is free text on Listing/Deal.
/**
 * Settlement assets, Solana network.
 * Two distinct uses, deliberately sharing one enum:
 * SETTLEMENT (Listing.payment, Offer.asset, Deal.asset) is SOL or STABLE.
 * USDC and USDT are interchangeable here and a seller does not care which
 * arrives, so terms are agreed in STABLE and the exact coin is unknown until
 * the payment lands. Both have 6 decimals, so amounts are unambiguous.
 * ACTUAL (PaymentProof.claimedAsset, TransactionLog.asset) records what was
 * really sent, so it stays USDC or USDT. Those rows are history: the ledger
 * is append-only and must never be rewritten to say something else moved.
 * USDC and USDT are therefore NOT deprecated — they are still the only correct
 * values for the actual columns. Use the SettlementAsset type in lib/money.ts
 * to keep the two apart in code.
 */
enum PaymentAsset {
  SOL
  USDC
  USDT
  STABLE
}

enum SpotType {
  GTD // guaranteed mint spot
  FCFS // first come, first served — over-allocation is not refundable
}

/// The precise escrow flow, confirmed by both parties inside the ticket.
/// Never auto-derived from ListingType. Money flows per docs/deal-methods.md.
enum DealMethod {
  DISCORD_SURRENDER
  WALLET_SURRENDER
  WALLET_SUBMIT
  MINT_FOR_YOU
  PRESALE
  CODE // flow still undocumented — do not implement (docs/deal-methods.md §6)
  OTC
}

/// The 12 lifecycle states, in order. Do not add, rename, or reorder without
/// asking — see "Deal Lifecycle" in CLAUDE.md. The server derives state; a
/// client request never sets it directly.
enum DealStatus {
  OPEN
  CLAIMED
  TERMS_LOCKED
  AWAITING_PAYMENT
  FUNDED
  DELIVERING
  AWAITING_MINT // deals sit here for days or weeks — this is normal
  AWAITING_CONFIRMATION
  COMPLETED
  DISPUTED
  REFUNDED
  CANCELLED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
  EXPIRED
}

enum ProofKind {
  BUYER_PAYMENT // deal amount + MM fee (+ mint price on some methods)
  SELLER_COLLATERAL
  MM_RELEASE // MM paying the seller out
  MM_REFUND // MM returning funds to the buyer
  MM_COLLATERAL_RETURN
  SELLER_NFT_TRANSFER // Mint For You / OTC — NFT sent, not currency
}

enum ProofStatus {
  SUBMITTED // awaiting MM review — NEVER advances deal state
  CONFIRMED // an MM opened the reference and verified it personally
  REJECTED // MM says it does not check out
}

/// Every fund movement and every state change writes one TransactionLog row.
enum TransactionAction {
  DEAL_CREATED
  DEAL_CLAIMED
  TERMS_LOCKED
  PROOF_SUBMITTED
  PROOF_CONFIRMED
  PROOF_REJECTED
  /// The middleman opened the payment window. Distinct from DEAL_FUNDED, which
  /// records that both payments were actually confirmed.
  PAYMENT_REQUESTED
  DEAL_FUNDED
  HANDOVER_DECLARED
  DELIVERY_MARKED
  RECEIPT_CONFIRMED
  FUNDS_RELEASED
  COLLATERAL_RETURNED
  COLLATERAL_FORFEITED
  REFUND_ISSUED
  MM_FEE_TAKEN
  /// refund-mm-fee: the MM fee is reversed back to the buyer.
  MM_FEE_REFUNDED
  DEAL_CANCELLED
  DEAL_ESCALATED
  DISPUTE_RULED
  ADMIN_OVERRIDE
  /// An admin opened a deal room they are not a participant in. Admin audit
  /// access is permitted but ALWAYS logged — see "Core Concept: Deal Rooms"
  /// in CLAUDE.md. Write one row per access, never a silent read.
  AUDIT_ACCESS
}

enum MessageKind {
  USER
  SYSTEM // system bot: deal embeds, fee calc, timer notices
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id String @id @default(cuid())

  // --- identity (Better Auth core fields) ---
  /// Sign-in is email/password via Better Auth. No wallet sign-in, ever.
  /// The password hash lives on Account.password, never here.
  email         String  @unique
  emailVerified Boolean @default(false)
  /// Better Auth's `name` and `image` are mapped onto these two existing
  /// columns via the adapter's field mapping, rather than duplicating them.
  displayName   String?
  avatarUrl     String?

  /// Optional: Discord OAuth is deferred, not abandoned. When a user links a
  /// Discord account later these fill in. Nullable so email/password signup
  /// works at all — they were required while Discord was the only provider.
  discordId       String? @unique
  discordUsername String?

  role   UserRole   @default(USER)
  status UserStatus @default(ACTIVE)

  // --- middleman profile fields (null/false for ordinary users) ---
  /// Published working hours, e.g. "09:00-21:00 UTC" or "flexible".
  workingHoursUtc String?
  /// Drives the verified-MM badge on the canonical roster page, which is the
  /// anti-impersonation reference. Impersonation is the top threat.
  isVerifiedMm    Boolean @default(false)
  tradesSecured   Int     @default(0)

  /// When this user explicitly accepted the guidelines/terms and privacy
  /// policy. The Discord treats opening a ticket as implicit agreement; the
  /// web platform requires an explicit checkbox and records the timestamp.
  /// Null means never accepted — gate ticket creation on it.
  termsAcceptedAt DateTime?

  // --- alt-account / same-person signals (admin-only, never shown publicly) ---
  /// Hashes, never raw values: a salted digest of the last-seen IP and a
  /// client-generated device id. Stored so shared IPs and devices can be
  /// flagged alongside shared wallets (UserWallet.address), which is the
  /// `same-person` detection the Discord does by hand.
  /// Never log or expose these; they are personal data used only for fraud
  /// review. Do not attempt to reverse them — comparison is equality-only.
  lastSeenIpHash   String?
  lastSeenDeviceId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wallets  UserWallet[]
  accounts Account[]
  sessions Session[]

  listings Listing[]
  offers   Offer[]

  buyerDeals     Deal[] @relation("DealBuyer")
  sellerDeals    Deal[] @relation("DealSeller")
  middlemanDeals Deal[] @relation("DealMiddleman")
  escalatedDeals Deal[] @relation("DealEscalatedBy")

  submittedProofs PaymentProof[] @relation("ProofSubmittedBy")
  verifiedProofs  PaymentProof[] @relation("ProofVerifiedBy")

  transactionLogs TransactionLog[]
  dealMessages    DealMessage[]
  vouchesWritten  Vouch[]          @relation("VouchAuthor")
  vouchesReceived Vouch[]          @relation("VouchMiddleman")
  settingsUpdated AdminSetting[]

  @@index([role, isVerifiedMm])
  @@index([status])
}

/// Replaces a single User.primaryWalletAddress field. Modelled as its own
/// table so the same address appearing under two accounts is detectable —
/// that is the alt-account / same-person signal the Discord tracks manually.
model UserWallet {
  id      String  @id @default(cuid())
  userId  String
  /// Plain-text reference string that humans read. The platform never parses,
  /// resolves, validates against a chain, or derives any meaning from it, and
  /// never holds the corresponding key.
  address String
  label   String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, address])
  /// Non-unique on purpose: a collision here IS the alt-account flag.
  @@index([address])
}

// --- Better Auth (email/password) --------------------------------------------
// Shapes are dictated by Better Auth's core schema — field names must match or
// be mapped in lib/auth.ts. These four carry onDelete: Cascade rather than
// Restrict. Deliberate exception: auth rows are transient state, not audit
// data. Every deal-related relation still uses Restrict.

/// Credential and linked-provider records. One row per auth method per user.
model Account {
  id     String @id @default(cuid())
  userId String

  /// Provider's id for this account. For email/password this is the user id.
  accountId  String
  /// "credential" for email/password; "discord" once OAuth is enabled.
  providerId String
  /// Better Auth 1.7 records the issuing authority, e.g. "local:credential".
  issuer     String?

  /// The scrypt password hash for credential accounts. NEVER log this column,
  /// never return it from an API, never put it in a TransactionLog.
  password String?

  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

/// Database-backed sessions. This is why Better Auth was chosen over Auth.js:
/// a blacklisted user's session can be revoked immediately by deleting the row,
/// which a JWT-only credentials flow cannot do.
model Session {
  id     String @id @default(cuid())
  userId String

  token     String   @unique
  expiresAt DateTime

  /// Raw values, deliberately — Better Auth surfaces them in session
  /// management so a user can recognise their own devices. They expire with
  /// the session. The long-lived alt-account signals stay hashed on User
  /// (lastSeenIpHash / lastSeenDeviceId). See docs/DECISIONS.md.
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Email-verification and password-reset tokens.
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}

/// Better Auth's rate-limit counters. Stored in the database rather than the
/// default in-memory store, which would silently do nothing across Vercel's
/// serverless instances — each cold start would get a fresh empty counter.
model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt

  @@index([key])
}

// ---------------------------------------------------------------------------
// Marketplace
// ---------------------------------------------------------------------------

/// One model for both /buy and /sell — the commands share an identical field
/// set and differ only by `side`. One form component, not two.
model Listing {
  id       String      @id @default(cuid())
  side     ListingSide
  authorId String

  // --- required listing fields ---
  item      String
  /// The PROJECT's network (Ethereum, Solana, Base, Robinhood...). This is NOT
  /// the settlement network — a Base project still settles in SOL/USDC/USDT on
  /// Solana. Free text, not an enum: new chains appear constantly.
  chain     String
  /// Smallest unit of `payment`. `price` + `payment` travel together.
  price     BigInt
  priceType PriceType
  /// Settlement asset. Distinct from `chain` above — these get confused
  /// constantly, so label them separately in the UI.
  payment   PaymentAsset
  specific  SpotType
  type      ListingType

  // --- optional listing fields ---
  quantity          Int     @default(1)
  /// How many spots are still unclaimed. Initialize to `quantity` when the
  /// listing is created (Prisma cannot default one column from another, so the
  /// creating code must set it explicitly) and decrement as deals complete.
  /// Without this, a quantity-20 listing that sells 5 spots is unrepresentable
  /// — it could only be ACTIVE or FULFILLED. Must stay within 0..quantity;
  /// enforced by the listing_quantity_remaining_in_range CHECK, applied in
  /// migration 20260826172419_enforce_ledger_immutability.
  quantityRemaining Int
  /// Seller's pledged collateral, in `payment` units. Null means "None".
  /// The configured per-method/tier minimum is enforced in app code, not here
  /// (it is an AdminSetting, never a hardcoded value).
  collateral        BigInt?
  /// External URL, usually x.com.
  projectLink       String?
  /// Whether the poster accepts offers. Sellers negotiate up, buyers down.
  acceptsOffers     Boolean @default(false)
  // TODO: a 12th optional /buy//sell field exists but is still unidentified.
  // Confirm what it is before finalizing — do not invent one.

  // --- derived / system ---
  /**
   * /**
   * Created by an automated test. Same reasoning as Deal.isTest: a listing
   * referenced by a deal cannot be deleted (onDelete: Restrict), so test
   * fixtures would otherwise sit in the public marketplace forever.
   */
  isTest        Boolean       @default(false)
  status        ListingStatus @default(ACTIVE)
  /// prem-listing: paid/promoted tier, granted via an admin surface.
  promoted      Boolean       @default(false)
  promotedUntil DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  expiresAt     DateTime?

  author User    @relation(fields: [authorId], references: [id], onDelete: Restrict)
  offers Offer[]
  deals  Deal[]

  @@index([side, status])
  @@index([status, createdAt])
  @@index([status, promoted, promotedUntil])
  @@index([chain])
  @@index([type])
  @@index([authorId])
}

/// Shown only when the listing's author set acceptsOffers.
model Offer {
  id        String @id @default(cuid())
  listingId String
  offererId String

  amount  BigInt
  asset   PaymentAsset
  message String?

  status      OfferStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  respondedAt DateTime?

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  offerer User    @relation(fields: [offererId], references: [id], onDelete: Restrict)

  @@index([listingId, status])
  @@index([offererId])
}

// ---------------------------------------------------------------------------
// Deal rooms
// ---------------------------------------------------------------------------

/// One Deal == one Deal Room == one Discord ticket channel.
/// Participants: buyer, seller, assigned middleman, system bot. Nobody else
/// reads it. Every deal-scoped query goes through assertDealParticipant().
model Deal {
  id String @id @default(cuid())

  /// Human-facing display string generated from the real fields below
  /// (mm / batch / username / project). Rendered only.
  /// NEVER parse this for logic — read the actual columns instead.
  reference String @unique

  /// NOT @unique. Many tickets share one batch number — it mirrors the Discord
  /// ticket-category numbering (`08-buyer-project`, `akla-08-...`), where a
  /// batch groups concurrent tickets. Indexed for queue views, not constrained.
  batchNumber Int

  /// Null when a deal is opened directly rather than via Quick Buy / Quick Sell.
  listingId   String?
  buyerId     String
  sellerId    String
  /// Null until a middleman claims the ticket and joins the room.
  middlemanId String?

  status DealStatus @default(OPEN)

  // --- terms (locked at funding; later changes need both parties'
  //     re-confirmation plus a TransactionLog entry) ---
  projectName String
  /// The project's network — free text, same distinction as Listing.chain.
  chain       String

  /// The precise escrow flow. Nullable on purpose: it stays unset until BOTH
  /// parties explicitly confirm it, and is never auto-derived from
  /// listing.type — that mapping only supplies a UI default.
  method                    DealMethod?
  methodConfirmedByBuyerAt  DateTime?
  methodConfirmedBySellerAt DateTime?

  /// All amounts are smallest-unit BigInt denominated in `asset`.
  /// dealAmount excludes MM fee and mint price — see the vocabulary in
  /// CLAUDE.md. Which of these the buyer actually pays depends on the
  /// confirmed method (docs/deal-methods.md).
  dealAmount       BigInt
  mmFee            BigInt
  mintPrice        BigInt?
  collateralAmount BigInt?
  asset            PaymentAsset

  quantity  Int       @default(1)
  specific  SpotType
  priceType PriceType

  /// Drives the verification window, release timers, and mint-day reminders.
  /// Nullable and mutable: projects delay, sometimes by months.
  mintAt DateTime?

  // --- lifecycle timestamps ---
  claimedAt     DateTime?
  termsLockedAt DateTime?
  fundedAt      DateTime?
  completedAt   DateTime?
  cancelledAt   DateTime?

  // --- release timers (enforced by scheduled jobs) ---
  // Absolute deadlines, resolved from the per-method config
  // (docs/deal-methods.md) at the moment each timer STARTS, then stored. They
  // are not recomputed on read: an admin retuning a window must not
  // retroactively move a deadline on a deal already running.
  //
  // Stored as timestamps rather than durations so a scheduled job can
  // index-scan for due work (`status = X AND <deadline> <= now()`) instead of
  // walking every deal and recomputing.
  /// Mint For You: seller must deliver the NFT within 6h after mint, or the
  /// deal fails and the buyer receives all funds.
  sellerDeliveryDeadline DateTime?
  /// Wallet Submit with post-mint release: buyer has 2h max to confirm.
  buyerConfirmDeadline   DateTime?
  /// Buyer non-response after mint: funds auto-release to the seller after 24h
  /// (Wallet Surrender, Mint For You). Auto-release still requires the method's
  /// configured timer to have elapsed — never release early.
  autoReleaseAt          DateTime?
  /// Non-null while the clock is stopped (dispute open, project mint delayed
  /// indefinitely). Scheduled jobs MUST skip deals where this is set, and the
  /// remaining time is recomputed when timers resume.
  timersPausedAt         DateTime?

  /// Each party independently acknowledges that the off-platform handover
  /// happened. Both are required before delivery can progress.
  handoverDeclaredByBuyerAt  DateTime?
  handoverDeclaredBySellerAt DateTime?

  /// Set when a private key or Discord credential handover is DECLARED to have
  /// happened off-platform. The platform never sees the secret itself — only
  /// that both parties acknowledged the handover, and when.
  /// Once this is set the deal can no longer be CANCELLED by mutual agreement;
  /// only dispute resolution applies.
  ///
  /// Only set for methods whose handover IS private data (private key, Discord
  /// account). An NFT transfer is a delivery, not a secret, so it does not
  /// close the cancellation window.
  privateDataHandedOverAt DateTime?

  /// The buyer confirming they received what they paid for. Release normally
  /// requires this; once autoReleaseAt passes, buyer silence stops blocking it.
  receiptConfirmedAt DateTime?

  /**
   * Created by an automated test rather than by a person.
   * Test suites drive real deals through the real engine, which is the point —
   * but the ledger is append-only and deals cannot be deleted, so the debris
   * would otherwise surface in public feeds as if it were trade history.
   * Public surfaces (recent sales, last-sales, dashboard counts) filter on this.
   */
  isTest Boolean @default(false)

  /// When this deal took its spots out of the listing's supply.
  ///
  /// Spots reserve at FUNDING, not at deal creation — several buyers may hold
  /// open deals on the same listing and the first to fund wins. Stamped rather
  /// than inferred from status history so the release path cannot double-return
  /// spots for a deal that never reserved any.
  spotsReservedAt DateTime?

  // --- dispute escalation (ticket-problem) ---
  escalatedById    String?
  escalatedAt      DateTime?
  escalationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listing     Listing? @relation(fields: [listingId], references: [id], onDelete: Restrict)
  buyer       User     @relation("DealBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  seller      User     @relation("DealSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  middleman   User?    @relation("DealMiddleman", fields: [middlemanId], references: [id], onDelete: Restrict)
  /// A real relation, not a bare id string — the escalator is a User and the
  /// dispute queue joins on them.
  escalatedBy User?    @relation("DealEscalatedBy", fields: [escalatedById], references: [id], onDelete: Restrict)

  proofs   PaymentProof[]
  messages DealMessage[]
  logs     TransactionLog[]
  vouches  Vouch[]

  @@index([status, createdAt])
  @@index([middlemanId, status])
  @@index([buyerId])
  @@index([sellerId])
  @@index([batchNumber])
  @@index([status, mintAt])
  // Let the timer jobs index-scan for due work rather than scanning all deals.
  @@index([status, autoReleaseAt])
  @@index([status, sellerDeliveryDeadline])
  @@index([status, buyerConfirmDeadline])
}

/// The manual verification record. One row per "sends X and submits Solscan
/// link" step in docs/deal-methods.md.
///
/// A SUBMITTED proof is UNVERIFIED DATA and changes nothing. Only an explicit
/// middleman confirmation advances deal state. Never auto-confirm — not on a
/// timer, not in DEMO_MODE, not for any reason.
///
/// Access this only through the PaymentVerifier interface (CLAUDE.md); escrow
/// code must never touch a verifier implementation directly.
model PaymentProof {
  id     String    @id @default(cuid())
  dealId String
  kind   ProofKind

  submittedById String
  submittedAt   DateTime @default(now())

  /// Solscan URL or raw tx signature, exactly as the user pasted it. An opaque
  /// human-readable reference: the server NEVER parses, resolves, or fetches
  /// it. It is rendered as a link the middleman opens themselves.
  reference     String
  /// What the submitter CLAIMS was sent. Not authoritative until confirmed —
  /// the middleman verifies the real amount by reading the link.
  claimedAmount BigInt?
  claimedAsset  PaymentAsset?
  screenshotUrl String?

  status ProofStatus @default(SUBMITTED)

  /// The MM who personally checked it. Required to leave SUBMITTED — no
  /// anonymous confirmations.
  ///
  /// MUST NOT equal submittedById: nobody verifies their own payment. Prisma's
  /// PSL cannot express CHECK constraints, so that rule is enforced in
  /// migration 20260826172419_enforce_ledger_immutability
  /// (the payment_proof_no_self_verification CHECK) AND in the service layer,
  /// lib/payments/verifier.ts. The CHECK is a backstop, not the only guard.
  verifiedById String?
  verifiedAt   DateTime?
  verifierNote String?

  deal        Deal             @relation(fields: [dealId], references: [id], onDelete: Restrict)
  submittedBy User             @relation("ProofSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  verifiedBy  User?            @relation("ProofVerifiedBy", fields: [verifiedById], references: [id], onDelete: Restrict)
  /// Every confirm/reject writes a TransactionLog row naming the verifier.
  logs        TransactionLog[]

  @@index([dealId, kind])
  /// MM review queue.
  @@index([status, submittedAt])
  @@index([submittedById])
}

/// Append-only deal-room transcript. No edit or delete columns by design;
/// exported verbatim when the ticket closes.
model DealMessage {
  id       String  @id @default(cuid())
  dealId   String
  /// Null for system-bot messages (deal embeds, fee calc, timer notices).
  authorId String?

  kind          MessageKind @default(USER)
  body          String
  attachmentUrl String?

  createdAt DateTime @default(now())

  deal   Deal  @relation(fields: [dealId], references: [id], onDelete: Restrict)
  author User? @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([dealId, createdAt])
  @@index([authorId])
}

/// Immutable ledger. One row for every fund movement and every state change:
/// actor, deal, action, amount, before/after state, timestamp, tx reference.
///
/// There is deliberately NO updatedAt — rows are never modified. UPDATE and
/// DELETE are blocked at the database by the transaction_log_no_change trigger,
/// which RAISEs (SQLSTATE 23001) rather than silently discarding the write.
/// Applied in migration 20260826172419_enforce_ledger_immutability.
model TransactionLog {
  id String @id @default(cuid())

  dealId  String?
  actorId String
  action  TransactionAction

  amount BigInt?
  asset  PaymentAsset?

  fromStatus DealStatus?
  toStatus   DealStatus?

  /// The PaymentProof this entry relates to, when there is one. A real
  /// relation, not a bare id string — the audit trail joins proof to ledger.
  proofId   String?
  /// Tx signature / Solscan reference, copied as opaque text for the audit
  /// trail. Never resolved by the server.
  reference String?
  /// Free-form structured detail (ruling notes, admin context, timer id).
  /// Never put a key, seed phrase, or session token in here.
  metadata  Json?

  createdAt DateTime @default(now())

  deal  Deal?         @relation(fields: [dealId], references: [id], onDelete: Restrict)
  actor User          @relation(fields: [actorId], references: [id], onDelete: Restrict)
  proof PaymentProof? @relation(fields: [proofId], references: [id], onDelete: Restrict)

  @@index([dealId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([proofId])
}

// ---------------------------------------------------------------------------
// Reputation & config
// ---------------------------------------------------------------------------

/// Public post-deal testimonial for a middleman (mm-vouches).
model Vouch {
  id          String @id @default(cuid())
  /// Tied to a COMPLETED deal. This is a deliberate improvement over the
  /// Discord, where anyone can post a vouch — here the deal has to exist.
  dealId      String
  authorId    String
  middlemanId String

  /// NEW PRODUCT DECISION — not present in the Discord source.
  /// mm-vouches today is freeform text with NO rating scale; a numeric rating
  /// is an addition to the business process, not a port of it. Left optional
  /// so vouches migrated from Discord remain valid. Confirm with the product
  /// owner before making it required or surfacing an aggregate score on MM
  /// profiles — an average built from partial data would misrepresent MMs.
  rating Int?

  body      String
  createdAt DateTime @default(now())

  deal      Deal @relation(fields: [dealId], references: [id], onDelete: Restrict)
  author    User @relation("VouchAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  middleman User @relation("VouchMiddleman", fields: [middlemanId], references: [id], onDelete: Restrict)

  /// Buyer and seller may each vouch once per deal.
  @@unique([dealId, authorId])
  @@index([middlemanId, createdAt])
}

/// Admin-tunable values that must never be hardcoded: collateral minimums per
/// method/tier (~$5-$7 today), MM fee configuration, per-method release timer
/// overrides (24h / 6h / 2h).
///
/// The DealMethod rule table itself (buyerPays, collateralFormula, the release
/// windows) lives as TypeScript config per docs/deal-methods.md — one place,
/// as data, not scattered `if` chains. This model holds only what an admin
/// changes at runtime.
model AdminSetting {
  key         String  @id
  value       Json
  description String?

  updatedById String?
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: Restrict)
}
